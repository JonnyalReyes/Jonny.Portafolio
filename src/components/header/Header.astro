      transition: right 0.4s ease-in-out;
      z-index: 100;
    }

    .li-nav {
      padding: 30px 80px;
      text-align: center;
      width: 100%;
      margin: 0;
      
    }
    .li-nav:hover {
      background-color: rgb(174, 34, 255);
      color : #000
    }
    .li-nav:hover::before {
      content: "";
      width: 0;
      height: 0;
    }

    .menu-activado {
      right: 0px;
      transition: right 0.4s ease-in-out;
    }
    .menu-drop {
      top: 0;
