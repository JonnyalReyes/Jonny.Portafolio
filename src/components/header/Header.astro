      justify-content: space-between;
      top: 0;
      left: 0;
      z-index: 100;
      /* background: rgba(255,255,255,0.1);
        -webkit-backdrop-filter: blur(3px);
        backdrop-filter: blur(3px); */
    }
    .header-brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .header h1 {
      font-size: 1.4rem;
    }
    @media (max-width: 400px) {
      .header h1 {
        font-size: 1.15rem;
      }
      .lang-select {
        font-size: 11px;
        padding: 4px 18px 4px 6px;
      }
    }
    .container-bnt-menu {
      position: relative;
