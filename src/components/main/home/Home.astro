---
import { Image } from "astro:assets";
import photoperfil from "../../../../public/img/photo-perfil.jpeg";
import { cvLinks } from "../../../const/const";
---

<div class="content-presentation">
  <div class="linear-gradient-2"></div>
  <div class="linear-gradient-1"></div>
  <dir class="container-persentation">
    <div class="container-text">
      <!-- <h2 class="text-hello">Hola <strong>soy</strong></h2> -->
      <h2 class="text-name">Jonathan Reyes</h2>
      <h3
        class="profession-title"
        data-lang-es="Desarrollador Full Stack Jr"
        data-lang-en="Full Stack Developer Jr"
      >
        Desarrollador Full Stack Jr
      </h3>
      <p
        class="p-presentation"
        data-lang-es="Desarrollador full-stack con experiencia en la creación de aplicaciones web, tanto en el front-end como en el back-end. Uso de tecnologías como HTML5, CSS3, JavaScript, y frameworks como React, Next.js y Vite para el front-end, junto con PHP, Java, Python y bases de datos como MySQl, PL/SQL y SQL Server para el back-end. Capaz de transformar diseños creativos en interfaces interactivas y optimizar el rendimiento de las aplicaciones. Apasionado por crear soluciones innovadoras y escalables."
        data-lang-en="Full-stack developer experienced in building web applications across both front-end and back-end. Proficient in HTML5, CSS3, JavaScript, and frameworks like React, Next.js, and Vite for the front-end, alongside PHP, Java, Python, and databases such as MySQL, PL/SQL, and SQL Server for the back-end. Skilled in transforming creative designs into interactive interfaces and optimizing application performance. Passionate about building innovative and scalable solutions."
      >
        Desarrollador full-stack con experiencia en la creación de aplicaciones web, tanto en el front-end como en el back-end. Uso de tecnologías como HTML5, CSS3, JavaScript, y frameworks como React, Next.js y Vite para el front-end, junto con PHP, Java, Python y bases de datos como MySQl, PL/SQL y SQL Server para el back-end. Capaz de transformar diseños creativos en interfaces interactivas y optimizar el rendimiento de las aplicaciones. Apasionado por crear soluciones innovadoras y escalables.
      </p>
      <div class="container-curriculum">
        <a href="#contacto" class="a-action" id="hero-contact-btn" data-lang-es="Hablemos" data-lang-en="Let's talk">Hablemos</a>
        <a
          href={cvLinks.es}
          class="a-curriculum"
          id="cv-main-btn"
          target="_blank"
          rel="noopener noreferrer"
          data-cv-es={cvLinks.es}
          data-cv-en={cvLinks.en}
          data-lang-es="Ver CV"
          data-lang-en="View CV"
        >
          Ver CV
        </a>
      </div>
      <div class="container-social">
        <p class="" data-lang-es="Echa un vistazo a mi" data-lang-en="Check out my">Echa un vistazo a mi</p>
        <a href="https://github.com/JonnyalReyes" target="_blank">
          <li class="li-social">
            <i class="fa-brands fa-github"></i>
          </li>
        </a>
        <a
          href="https://www.linkedin.com/in/jonathanreyes15"
          target="_blank"
        >
          <li class="li-social">
            <i class="fa-brands fa-linkedin"></i>
          </li>
        </a>
      </div>
    </div>
    <div class="container-photo-profile">
      <div class="photo-perfil">
        <picture>
          {/* If you are not using vercel, place a normal <img> tag */}
          <Image src={photoperfil} alt="Jonathan Reyes" id="inicio" />
        </picture>
      </div>
    </div>
  </dir>
</div>

<script>
  // Sincronización de idioma para botones, textos y enlaces de CV
  const $cvMainBtn = document.querySelector("#cv-main-btn");
  const $contactBtn = document.querySelector("#hero-contact-btn");
  const $socialText = document.querySelector(".container-social p");
  const $professionTitle = document.querySelector(".profession-title");

  const updateHomeLanguage = (lang) => {
    if ($cvMainBtn) {
      const url = lang === "en" ? $cvMainBtn.getAttribute("data-cv-en") : $cvMainBtn.getAttribute("data-cv-es");
      if (url) $cvMainBtn.setAttribute("href", url);
      $cvMainBtn.textContent = lang === "en" ? "View CV" : "Ver CV";
    }
    if ($contactBtn) {
      $contactBtn.textContent = lang === "en" ? "Let's talk" : "Hablemos";
    }
    if ($socialText) {
      $socialText.textContent = lang === "en" ? "Check out my" : "Echa un vistazo a mi";
    }
    if ($professionTitle) {
      $professionTitle.textContent = lang === "en" ? "Full Stack Developer Jr" : "Desarrollador Full Stack Jr";
    }
  };

  const initialLang = localStorage.getItem("portfolio_lang") || "es";
  updateHomeLanguage(initialLang);

  window.addEventListener("languageChange", (e) => {
    updateHomeLanguage(e.detail.lang);
  });
</script>

<style>
  .content-presentation {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .linear-gradient-1 {
    position: absolute;
    left: 0;
    top: 0;
    width: 500px;
    height: 520px;
    background: radial-gradient(
      at left center,
      rgb(174, 34, 255),
      transparent,
      transparent
    );
    z-index: 0;
  }
  .linear-gradient-2 {
    position: absolute;
    right: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      at right center,
      rgb(174, 34, 255),
      rgb(0, 0, 0),
      rgb(0, 0, 0)
    );
    z-index: 0;
  }

  .container-persentation {
    position: relative;
    display: flex;
    flex-direction: row;
    padding: 50px 0;
    width: 90%;
    margin: 0 auto;
    max-width: 1355px;
  }
  .container-text {
    position: relative;
    width: 56%;
    color: #f6f6f9;
  }
  .text-hello {
    padding: 10px 0;
    font-size: 20px;
  }

  .text-name {
    padding: 5px 0;
    font-size: 30px;
    color:rgb(174, 34, 255);
    font-weight: 800;
    letter-spacing: 1px;
    margin-top: 30px;
  }
  .profession-title {
    font-size: 26px;
    font-weight: 700;
    color: #e2e8f0;
    padding: 6px 0 10px 0;
    margin: 0;
    letter-spacing: 0.5px;
    cursor: default;
    user-select: text;
  }

  .p-presentation {
    padding: 12px 0;
    font-size: 19px;
    width: 90%;
    text-align: left;
  }

  .container-curriculum {
    position: relative;
    padding: 40px 0;
    display: flex;
    gap: 20px;
  }
  .a-action {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px 30px;
    border: 1px solid rgb(174, 34, 255);
    font-size: 18px;
    background-color: rgb(174, 34, 255);
    text-decoration: none;
    color: #f6f6f9;
    transition: 0.3s;
  }
  .a-action:hover {
    transform: translateX(4px);
  }

  .a-curriculum {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px 30px;
    color: #f6f6f9;
    border: 1px solid rgb(174, 34, 255);
    font-size: 18px;
    text-decoration: none;
    transition: 0.3s;
  }

  .a-curriculum:hover {
    background-color: rgb(127, 15, 142);
    transform: translateX(4px);
  }

  .container-social {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: start;
    align-items: center;
    gap: 15px;
  }

  .container-social a {
    text-decoration: none;
  }

  .li-social {
    position: relative;
    list-style: none;
    background-color: rgb(174, 34, 255);
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    display: flex;
    justify-content: center;
    align-items: center;
    height: 35px;
    width: 40px;
  }

  .li-social i {
    font-size: 25px;
    color: #f6f6f9;
  }

  .li-social:hover {
    transform: rotate(-360deg);
  }

  .container-photo-profile {
    position: relative;
    width: 50%;
    display: flex;
    justify-content: center;
  }

  .photo-perfil {
    position: relative;
    display: flex;
    justify-content: center;
    overflow: hidden;
    height: 300px;
    width: 300px;
    margin-top: 30px;
    margin-left: 110px;
    border-radius: 50%;
    z-index: 10;
    background: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    /* border-radius: 64% 36% 29% 71% / 59% 79% 21% 41%; */
  }

  .photo-perfil img {
    position: relative;
    display: block;
    object-fit: cover;
    height: 100%;
    width: 100%;
    filter: drop-shadow(-10px -5px 10px #000) contrast(110%);
    transition: 0.3s;
  }

  /* responsive */
  @media (max-width: 900px) {
    .container-persentation {
      flex-direction: column-reverse;
      height: auto;
      gap: 30px;
      padding-top: 100px;
    }
    .container-photo-profile {
      width: 100%;
      justify-content: center;
      justify-items: center;
      margin: 0;
    }
    .photo-perfil {
      margin: 0;
    }
    .container-text {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .p-presentation {
      width: 100%;
    }
  }

  @media (max-width: 500px) {
    .container-curriculum {
      display: flex;
      gap: 10px;
    }
    .linear-gradient-1 {
      display: none;
    }
  }
</style>
